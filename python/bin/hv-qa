#!/usr/bin/env python3
"""
hv-qa: Opinionated workflow orchestration for hotvect

This tool provides higher-level scenario-oriented commands that sit on top of
the lower-level hotvect CLIs.
"""

import sys

try:
    from hotvect.qa.cli import main
except ModuleNotFoundError as e:  # pragma: no cover - runtime UX guard
    if e.name == "hotvect":
        print(
            "Error: hotvect is not installed in this Python environment.\n"
            "Install it first (for example from the repository root):\n"
            "  cd python && uv pip install -e .",
            file=sys.stderr,
        )
        raise SystemExit(1) from e
    raise

if __name__ == "__main__":
    raise SystemExit(main())
